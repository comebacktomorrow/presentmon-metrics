<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for the exporter's PresentMon-free logic. SwapChainMap.cs is compiled in
       directly rather than referencing the Windows service project, so these build and run
       anywhere .NET 8 does (CI runs them on windows-latest before publishing). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../src/KioskPresentMonExporter/SwapChainMap.cs" Link="SwapChainMap.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
